# Copy this file to .env and change the passwords. Never commit .env.
# docker compose reads it automatically; the backend also reads it when run locally with mvnw.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_DB=telereleve
POSTGRES_USER=telereleve
POSTGRES_PASSWORD=change-me
# Port published on the host (the backend container always uses 5432 internally)
POSTGRES_PORT=5432

# --- MQTT broker (Mosquitto) ---
MQTT_USERNAME=telereleve
MQTT_PASSWORD=change-me
MQTT_PORT=1883

# --- Mail catcher (Mailpit) ---
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- Backend ---
BACKEND_PORT=8080
