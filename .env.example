# Copy this file to .env and change the passwords. Never commit .env.
# docker compose reads it automatically; the backend also reads it when run locally with mvnw.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_DB=telereleve
POSTGRES_USER=telereleve
POSTGRES_PASSWORD=change-me
# Port published on the host (the backend container always uses 5432 internally)
POSTGRES_PORT=5432

# --- MQTT broker (Mosquitto) ---
MQTT_USERNAME=telereleve
MQTT_PASSWORD=change-me
MQTT_PORT=1883

# --- Mail catcher (Mailpit) ---
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- Backend ---
BACKEND_PORT=8080
# Web interface (nginx). Stop the frontend container before running `ng serve`, which also uses 4200.
FRONTEND_PORT=4200
# Key signing the login tokens (JWT, HS256): base64, at least 32 bytes. Generate your own, e.g.
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=change-me-generate-a-base64-key
# Password of the demo accounts admin / operateur / technicien / technicien2 (dev profile only)
APP_SEED_DEMO_PASSWORD=demo1234
# Password of the simulator's technical account "simulateur" (dev profile creates it)
SIMULATOR_PASSWORD=change-me
# "dev" creates demo data (meters around Fès); leave empty in production
SPRING_PROFILES_ACTIVE=dev
# Size of the demo meter park (50 by default, 1000 for the load test)
APP_SEED_METER_COUNT=50

# --- Simulator ---
# Seconds between two readings of the same meter (60 = demo mode)
SIM_INTERVAL_SECONDS=60
# Simulate at most N meters (0 = every active meter)
SIM_MAX_METERS=0
# Days of history published at startup (every 15 min), so charts and rule A2 have data at once
SIM_BACKFILL_DAYS=4
# Injected anomalies: SERIAL:TYPE with TYPE in ZERO, SPIKE, SILENT, DECREASING_INDEX, VOLTAGE
SIM_ANOMALIES=CEAC-E-000005:DECREASING_INDEX,CEAC-E-000008:VOLTAGE,CEAC-E-000011:SILENT,CEAC-E-000012:SPIKE,CEAC-W-000004:ZERO
# Percentage of the other meters given a random anomaly (0 = none)
SIM_ANOMALY_PERCENT=0
# Minutes before the anomalies start; negative = in the past (-1500 = 25 h ago, so A1 shows at once)
SIM_ANOMALY_DELAY_MINUTES=-1500
# Optional: exact start of the anomalies (ISO-8601 UTC, e.g. 2026-10-21T09:00:00Z). When empty, the start is
# computed once from the delay above, remembered in a Docker volume and reused at every restart; a restart
# therefore never contradicts the readings already stored. Wipe everything (docker compose down -v) for a
# fresh scenario.
SIM_ANOMALY_START=
# Alert e-mails (Mailpit catches them in development: http://localhost:8025)
ALERT_MAIL_TO=exploitation@ceac.test
